try.clavastack.com {
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
	}

	@browserShell path / /index.html /browser/site.js /browser/runtime-worker.js /simulators/ /simulators/index.html /simulators/site.js /bitcoin-keeper/ /bitcoin-keeper/index.html
	header @browserShell Cache-Control "no-cache"
	@specterShell path /specter-desktop/* /browser/specter-desktop-current.json
	header @specterShell Cache-Control "no-cache"
	@keeperBuild path /builds/keeper-web/*
	header @keeperBuild Cache-Control "public, max-age=31536000, immutable"

	@versionedBuild path_regexp versioned ^/builds/.+/micropython\.(js|wasm|data)$
	header @versionedBuild Cache-Control "public, max-age=31536000, immutable"
	@buildManifest path_regexp manifest ^/builds/.+/build-info\.json$
	header @buildManifest Cache-Control "no-cache"
	header /browser/current.json Cache-Control "no-cache"
	header /browser/variants/* Cache-Control "no-cache"
	header /api/ab/* Cache-Control "no-store"

	# Never route or serve the retired, unauthenticated VNC pool, even if an
	# old file is accidentally copied into the static webroot.
	@retiredVnc path /api/allocate /api/heartbeat /api/release /api/status /api/feedback /api/feedback/* /diy/sim/* /play/sim/* /schnuartz/sim/* /restart/* /simulator-ws* /playground-ws* /websockify* /novnc /novnc/* /simulators/legacy /simulators/legacy/*
	handle @retiredVnc {
		respond "The legacy VNC simulator has been retired." 410
	}

	@abArtifacts path /ab-builds/*
	header @abArtifacts Cache-Control "public, max-age=31536000, immutable"
	handle_path /ab-builds/* {
		root * /var/lib/try-clavastack/ab-builds
		file_server
	}

	handle /api/ab/* {
		reverse_proxy 127.0.0.1:9002
	}

	root * /var/www/try-clavastack-deploy/current
	file_server
	encode zstd gzip
}
