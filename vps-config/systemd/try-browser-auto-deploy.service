[Unit]
Description=Deploy the latest tested try.clavastack.com site release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The release atomically updates the static webroot and its isolated Caddy
# site block. No simulator process or allocator is installed on the VPS.
User=root
Group=root
RuntimeDirectory=try-clavastack
StateDirectory=try-clavastack
UMask=0022
ExecStart=/usr/local/libexec/try-clavastack/deploy-site-release.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/try-clavastack-deploy /var/lib/try-clavastack /run/try-clavastack /etc/caddy
