[Unit]
Description=Deploy the latest tested try.clavastack.com site release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The release also atomically updates the root-owned allocator runtime and
# Caddy configuration. Keep the webroot/state paths restricted while granting
# this oneshot the privileges required for those two coordinated updates.
User=root
Group=root
RuntimeDirectory=try-clavastack
StateDirectory=try-clavastack
UMask=0022
ExecStart=/usr/local/libexec/try-clavastack/deploy-site-release.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/try-clavastack-deploy /var/lib/try-clavastack /run/try-clavastack /opt/try-clavastack /etc/caddy
