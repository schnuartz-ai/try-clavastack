[Unit]
Description=Deploy the latest tested try.clavastack.com site release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=clavastack-deploy
Group=clavastack-deploy
RuntimeDirectory=try-clavastack
StateDirectory=try-clavastack
UMask=0022
ExecStart=/usr/local/libexec/try-clavastack/deploy-site-release.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/try-clavastack-deploy /var/lib/try-clavastack /run/try-clavastack
