[Unit]
Description=Allocator API Service for try.clavastack.com Simulator Pool
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/try-clavastack/pool
ExecStart=/usr/bin/python3 -u /opt/try-clavastack/pool/server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
