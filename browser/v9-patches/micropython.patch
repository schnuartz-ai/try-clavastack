diff --git a/shared/runtime/gchelper_generic.c b/shared/runtime/gchelper_generic.c
index 45b2e4f7..6262a6ad 100644
--- a/shared/runtime/gchelper_generic.c
+++ b/shared/runtime/gchelper_generic.c
@@ -211,12 +211,23 @@ static void gc_helper_get_regs(gc_helper_regs_t arr) {
 // LTO is enabled and a lot of inlining takes place we risk a stack
 // layout where regs is lower on the stack than pointers which have
 // just been allocated but not yet marked, and get incorrectly sweeped.
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+static void browser_gc_range(void *start, void *end) {
+    gc_collect_root(start, ((uintptr_t)end - (uintptr_t)start) / sizeof(uintptr_t));
+}
+#endif
 MP_NOINLINE void gc_helper_collect_regs_and_stack(void) {
+#ifdef __EMSCRIPTEN__
+    emscripten_scan_registers(browser_gc_range);
+    emscripten_scan_stack(browser_gc_range);
+#else
     gc_helper_regs_t regs;
     gc_helper_get_regs(regs);
     // GC stack (and regs because we captured them)
     void **regs_ptr = (void **)(void *)&regs;
     gc_collect_root(regs_ptr, ((uintptr_t)MP_STATE_THREAD(stack_top) - (uintptr_t)&regs) / sizeof(uintptr_t));
+#endif
 }
 
 #endif // MICROPY_ENABLE_GC
