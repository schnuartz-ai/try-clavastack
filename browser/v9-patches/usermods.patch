diff --git a/usermods/udisplay_f469/lv_sdl_hal/SDL/modSDL.c b/usermods/udisplay_f469/lv_sdl_hal/SDL/modSDL.c
index 4044a80..01a9b09 100644
--- a/usermods/udisplay_f469/lv_sdl_hal/SDL/modSDL.c
+++ b/usermods/udisplay_f469/lv_sdl_hal/SDL/modSDL.c
@@ -100,6 +100,24 @@ static SDL_Thread *s_tick_thread = NULL;
 static bool s_main_loop_set = false;
 #endif
 
+#ifdef __EMSCRIPTEN__
+/* Feed the real LVGL v9 SDL input device from the scaled browser pointer. */
+extern void lv_sdl_mouse_handler(SDL_Event *event);
+EMSCRIPTEN_KEEPALIVE void browser_pointer(int x, int y, int down) {
+  if (!s_mouse || !s_disp) return;
+  SDL_Event event;
+  memset(&event, 0, sizeof(event));
+  event.type = down == 0 ? SDL_MOUSEBUTTONUP :
+               down == 1 ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEMOTION;
+  event.button.windowID = 1; /* The simulator creates one SDL window. */
+  event.button.button = SDL_BUTTON_LEFT;
+  event.button.x = x;
+  event.button.y = y;
+  lv_sdl_mouse_handler(&event);
+  lv_indev_read(s_mouse);
+}
+#endif
+
